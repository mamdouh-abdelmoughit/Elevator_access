generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // e.g., file:./dev.db
}

model User {
  id                Int      @id @default(autoincrement())
  phone             String   @unique
  name              String
  password          String
  role              String   @default("EMPLOYEE") // Roles: ADMIN, EMPLOYEE, MANAGER (Syndic)
  
  // Relations
  managedElevators  Elevator[] // Elevators this Syndic manages
  requests          Request[]  // Requests sent by this Syndic
  
  createdAt         DateTime @default(now())
  latitude          Float?
  longitude         Float?
  locationUpdatedAt DateTime?
  isOnline          Boolean  @default(false)
  expoPushToken     String?
  cards             Card[]
  locationLogs      LocationLog[]
}

model LocationLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  latitude  Float
  longitude Float
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, timestamp])
}

model Elevator {
  id            Int      @id @default(autoincrement())
  name          String
  location      String
  
  // Link to the Syndic
  managerId     Int?
  manager       User?    @relation(fields: [managerId], references: [id])

  requests      Request[] // Requests related to this elevator

  // ... keep existing fields ...
  latitude      Float?
  longitude     Float?
  currentStatus String   @default("IDLE")
  lastHeartbeat DateTime @default(now())
  macAddress    String?  @unique
  createdAt     DateTime @default(now())
  permissions   Permission[]

  // Cabin-reader elevators: highest floor number (RDC = 0, floors 1..floorCount).
  // Set by the Syndic when configuring the building. Null = not configured yet
  // (or an older per-floor-reader elevator).
  floorCount    Int?
  // Top floor (terrasse / roof) is reachable by every resident.
  roofAccess    Boolean  @default(true)
  // How long the allowed car-call buttons stay unlocked after a valid swipe.
  unlockSeconds Int      @default(10)
  // "Accès libre": every floor button unlocked, no card needed (moving day, etc.).
  freeAccess    Boolean  @default(false)
}

model Card {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  
  // NEW: Who owns this card? (e.g. "Mr. Idrissi - Apt 4")
  label     String?  

  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  permissions Permission[]

  // Resident profile (cabin-reader elevators). The Permission rows of a card
  // are always derived from these fields — see src/services/accessRules.js.
  apartment     String?
  residentPhone String?
  homeFloor     Int?
  accessType    String    @default("RESIDENT") // RESIDENT | STAFF | CUSTOM
  customFloors  Int[]     @default([])         // only used when accessType = CUSTOM
  validUntil    DateTime?                      // null = permanent
  notes         String?
}

// NEW MODEL: The Communication Ticket
model Request {
  id          Int      @id @default(autoincrement())
  
  // Who asked?
  syndicId    Int
  syndic      User     @relation(fields: [syndicId], references: [id])

  // Which elevator?
  elevatorId  Int
  elevator    Elevator @relation(fields: [elevatorId], references: [id])

  // What do they want?
  type        String   // "BLOCK", "ACTIVATE", "NEW_CARD", "LOST_CARD"
  residentName String  // e.g. "Mr Idrissi - Apt 4"
  notes       String?  // Optional details

  // Request Status
  status      String   @default("PENDING") // "PENDING", "COMPLETED", "REJECTED"
  
  createdAt   DateTime @default(now())
}

// ... Keep Permission and Log models as they are ...
model Permission {
  id         Int      @id @default(autoincrement())
  cardId     Int
  elevatorId Int
  relay      Int      // cabin-reader elevators: floor number (0 = RDC)
  isActive   Boolean  @default(true)  // <--- ADD THIS
  card       Card     @relation(fields: [cardId], references: [id])
  elevator   Elevator @relation(fields: [elevatorId], references: [id])
  createdAt  DateTime @default(now())
  @@unique([cardId, elevatorId, relay])
}

model Log {
  id         Int      @id @default(autoincrement())
  timestamp  DateTime @default(now())
  eventType  String
  elevatorId Int?
  details    Json

  @@index([elevatorId, timestamp])
}