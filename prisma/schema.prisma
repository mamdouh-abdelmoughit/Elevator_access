generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL") // e.g., file:./dev.db
}

model User {
  id                Int      @id @default(autoincrement())
  phone             String   @unique
  name              String
  password          String
  role              String   @default("EMPLOYEE")
  createdAt         DateTime @default(now())
  latitude          Float?
  longitude         Float?
  locationUpdatedAt DateTime?

  cards             Card[]
}

model Card {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  permissions Permission[]
}

model Elevator {
  id        Int      @id @default(autoincrement())
  name      String
  location  String
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())

  permissions Permission[]
}

model Permission {
  id         Int      @id @default(autoincrement())
  cardId     Int
  elevatorId Int
  relay      Int

  card       Card     @relation(fields: [cardId], references: [id])
  elevator   Elevator @relation(fields: [elevatorId], references: [id])

  createdAt  DateTime @default(now())

  @@unique([cardId, elevatorId, relay])
}

model Log {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())
  eventType String
  details   Json
}
