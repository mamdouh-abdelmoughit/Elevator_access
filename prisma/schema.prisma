// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- YOUR DATABASE MODELS ---

// prisma/schema.prisma

// prisma/schema.prisma

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  cards     Card[]

  // --- NEW GEOLOCATION FIELDS ---
  isEmployee         Boolean?  @default(false)
  latitude           Float?
  longitude          Float?
  locationUpdatedAt  DateTime?
}

model Elevator {
  id          Int      @id @default(autoincrement())
  name        String
  location    String   // e.g., "Building A, Ground Floor"
  permissions Permission[]

  // --- NEW GEOLOCATION FIELDS ---
  latitude    Float?
  longitude   Float?
}

model Card {
  id        Int     @id @default(autoincrement())
  code      BigInt  @unique
  issuedTo  User?   @relation(fields: [userId], references: [id])
  userId    Int?    // The @unique attribute has been REMOVED from this line

  // A Card can have many Permissions
  permissions Permission[]
}

model Permission {
  id        Int     @id @default(autoincrement())
  card      Card    @relation(fields: [cardId], references: [id])
  cardId    Int
  elevator  Elevator @relation(fields: [elevatorId], references: [id])
  elevatorId Int
  
  // The specific relay (floor) this card can access on this elevator
  relay     Int     
  
  @@unique([cardId, elevatorId, relay]) // Prevents duplicate permissions
}

model Log {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())
  eventType String   // e.g., "ACCESS_ATTEMPT", "ENROLLMENT", "FAULT"
  details   Json     // A flexible JSON object for details
}